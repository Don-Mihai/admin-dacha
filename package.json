{
  "name": "utkina-dacha-admin",
  "version": "2.0.0",
  "description": "CMS Уткина дача: PostgreSQL + REST/GraphQL + JWT",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server\" \"vite\"",
    "server": "node server/index.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "node server/seed.js",
    "db:seed": "node server/seed.js",
    "build": "vite build",
    "build:win": "npm run build && pkg . --targets node18-win-x64 --output build/utkina-admin.exe",
    "pkg": "pkg . --targets node18-win-x64 --output build/utkina-admin.exe"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.1.6",
    "@mui/material": "^6.1.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.0",
    "graphql": "^16.10.0",
    "graphql-yoga": "^5.12.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "pkg": "^5.8.1",
    "vite": "^5.4.10"
  },
  "pkg": {
    "scripts": "server/index.js"
  }
}
